<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Stage C3 consolidation: one csproj replaces 12 platform variants
      (cocos2d.{DesktopGL,Linux,macOS,Windows,Android,iOS} plus the .Core.* duplicates).

        net10.0             DesktopGL host (Windows-GL, Linux, macOS via DesktopGL).
                            macOS *desktop* is served by net10.0 + DesktopGL.
        net10.0-windows7.0  WindowsDX (UseWindowsForms; replaces cocos2d.Windows).
        net10.0-android36.0 Android  (replaces cocos2d.Android).
        net10.0-ios26.0     iOS      (replaces cocos2d.iOS).
        net10.0-maccatalyst26.0
                            Mac Catalyst (C2D-238). MonoGame publishes no maccatalyst
                            package (still true at 3.8.5), so this TFM references the
                            Catalyst MonoGame.Framework built from our fork, and only
                            joins the TFM list on a macOS host that has it - see the
                            repo-root Directory.Build.props.

      Source physically remains under ../../cocos2d/ during the side-by-side
      transition; the new csproj globs it and applies platform-specific
      exclusions for the small set of -Platform.cs files. The legacy
      cocos2d/cocos2d.* and cocos2d/cocos2d.Core.* csproj folders are excluded.
    -->
    <!-- TFMs come from the repo-root Directory.Build.props ($(Cocos2DBaseTfm) etc.)
         so a .NET / MonoGame bump is a four-property change in one file (the 2.6.0
         move to net10.0 + MonoGame 3.8.5 was exactly that). -->
    <TargetFrameworks>$(Cocos2DTargetFrameworks)</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Cocos2D</RootNamespace>
    <!-- Assembly is Cocos2DMono (the product name); the source NAMESPACE remains Cocos2D
         so code migrating from the legacy per-platform packages compiles unchanged. -->
    <AssemblyName>Cocos2DMono</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <PackageId>Cocos2D-Mono</PackageId>
    <Title>Cocos2D-Mono</Title>
    <Product>Cocos2D-Mono</Product>
    <Description>Cocos2D-Mono is a managed C# port of cocos2d-x built on MonoGame. This single package multi-targets DesktopGL (Windows-GL, Linux, macOS), WindowsDX, Android, and iOS.</Description>
    <PackageReleaseNotes>
2.6.0 - The platform release: .NET 10 + MonoGame 3.8.5. No engine API changes.
Migration: retarget your game to .NET 10 (net10.0 desktop, net10.0-windows7.0 WindowsDX, net10.0-android36.0 Android, net10.0-ios26.0 iOS) and bump the package reference. Requires the .NET 10 SDK. Also migrated off MonoGame-obsoleted APIs; validated end-to-end on the new MonoGame native core.
2.5.12 - Final bug-fix release of the 2.5 line (action copies, CCMenuItemSprite null-clear, CCTextFieldTTF auto-edit, CCRawList RemoveRange corruption + buffer leak).
- See https://github.com/Cocos2D-Mono/cocos2d-mono for the full changelog.
    </PackageReleaseNotes>
    <PackageTags>mono monogame cocos2d game gamedev 2d mgcb content-pipeline</PackageTags>
    <PackageIcon>logo-small.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- ============================================================
       Per-TFM platform defines
       ============================================================ -->
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)'">
    <!-- DesktopGL covers Linux, macOS, and Windows-GL hosts. OS-specific constants
         are added below via MSBuild::IsOSPlatform so a single net10.0 build is portable. -->
    <DefineConstants>$(DefineConstants);OPENGL;MONOGAME;DESKTOPGL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)' and '$([MSBuild]::IsOSPlatform(`Windows`))' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWSGL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)' and '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true'">
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)' and '$([MSBuild]::IsOSPlatform(`Linux`))' == 'true'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DWindowsTfm)'">
    <!-- Matches legacy cocos2d.Windows.csproj exactly: XNA path, no MONOGAME.
         MonoGame's MonoGame.Framework.WindowsDX runtime still loads - the constant
         only gates source-level branches. CCContentManager.ReloadGraphicsAssets is
         public under #else (legacy XNA) and protected under #if MONOGAME; defining
         MONOGAME here would break the call in CCDrawManager.cs. A later stage can
         reconcile this divergence properly. -->
    <DefineConstants>$(DefineConstants);WINDOWS;XNA</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DAndroidTfm)'">
    <DefineConstants>$(DefineConstants);ANDROID;OPENGL;GLES;MONOGAME</DefineConstants>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DIosTfm)'">
    <DefineConstants>$(DefineConstants);__IOS__;__MOBILE__;__UNIFIED__;IPHONE;IOS;GLES;OPENGL;MONOGAME</DefineConstants>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <IPhoneResourcePrefix>Resources</IPhoneResourcePrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DMacCatalystTfm)'">
    <!-- Catalyst is iOS-plus-extras at source level: the fork's Catalyst
         MonoGame.Framework is the iOS platform code (UIKit host, GLES, touch) compiled
         for net10.0-maccatalyst, so the engine takes the same source paths as iOS and
         adds MACCATALYST for the seams that differ (desktop input, window sizing). -->
    <DefineConstants>$(DefineConstants);__IOS__;__MOBILE__;__UNIFIED__;IPHONE;IOS;MACCATALYST;GLES;OPENGL;MONOGAME</DefineConstants>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <IPhoneResourcePrefix>Resources</IPhoneResourcePrefix>
    <!-- MonoGame.Content.Builder.Task infers MonoGamePlatform from the TFM and has no
         mapping for -maccatalyst (it errors out at build). Catalyst runs iOS-built
         content unchanged, so it is the iOS content platform. -->
    <MonoGamePlatform>iOS</MonoGamePlatform>
  </PropertyGroup>

  <!-- Mobile TFMs: drop .snupkg generation. Apple/Android workloads emit
       platform-specific symbol formats and would trip NU5119 on pack. -->
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DIosTfm)' or '$(TargetFramework)' == '$(Cocos2DMacCatalystTfm)' or '$(TargetFramework)' == '$(Cocos2DAndroidTfm)'">
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5119</NoWarn>
  </PropertyGroup>

  <!-- ============================================================
       Source globbing (replaces cocos2d.projitems)
       ============================================================ -->
  <PropertyGroup>
    <Cocos2DSourceRoot>..\..\cocos2d\</Cocos2DSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Glob the entire shared tree. Exclusions:
        bin/ obj/                    - build artifacts
        cocos2d.* / cocos2d.Core.*   - legacy per-platform csproj folders (deleted at the
                                       C4 cutover; exclude kept defensively)
        external lib/**              - vendored ICSharpCode SharpZLib (never built by legacy
                                       either; the SharpZipLib NuGet provides the runtime types)
        Properties/AssemblyInfo*.cs  - SDK auto-generates assembly info from MSBuild props
        *.Designer.cs                - generated files (none today, glob is defensive)
    -->
    <Compile Include="$(Cocos2DSourceRoot)**\*.cs"
             Exclude="$(Cocos2DSourceRoot)bin\**;$(Cocos2DSourceRoot)obj\**;$(Cocos2DSourceRoot)cocos2d.*\**;$(Cocos2DSourceRoot)cocos2d.Core.*\**;$(Cocos2DSourceRoot)external lib\**;$(Cocos2DSourceRoot)Properties\AssemblyInfo*.cs;$(Cocos2DSourceRoot)**\*.Designer.cs" />
  </ItemGroup>

  <!-- Android-only files. -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-android'))">
    <Compile Remove="$(Cocos2DSourceRoot)EmbeddableView\CCGameView.Android.cs" />
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabel-Android.cs" />
  </ItemGroup>

  <!-- UIKit hosts: iOS and Mac Catalyst compile the same iOS-only files. -->
  <PropertyGroup>
    <_Cocos2DUIKitTfm>false</_Cocos2DUIKitTfm>
    <_Cocos2DUIKitTfm Condition="$(TargetFramework.Contains('-ios')) or $(TargetFramework.Contains('-maccatalyst'))">true</_Cocos2DUIKitTfm>
  </PropertyGroup>

  <!-- iOS-only files (shared with Mac Catalyst). -->
  <ItemGroup Condition="'$(_Cocos2DUIKitTfm)' != 'true'">
    <Compile Remove="$(Cocos2DSourceRoot)EmbeddableView\CCGameView.iOS.cs" />
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabel-CoreGraphics.cs" />
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabelUtilities-CoreGraphics.cs" />
  </ItemGroup>

  <!-- WindowsDX-only (GDI label backend). -->
  <ItemGroup Condition="'$(TargetFramework)' != '$(Cocos2DWindowsTfm)'">
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabel-Windows.cs" />
  </ItemGroup>

  <!-- DesktopGL-only (Skia/GDI label backends used by the base TFM). -->
  <ItemGroup Condition="'$(TargetFramework)' != '$(Cocos2DBaseTfm)'">
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabel-Gdi.cs" />
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabel-Skia.cs" />
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabelUtilities-Gdi.cs" />
    <Compile Remove="$(Cocos2DSourceRoot)label_nodes\CCLabelUtilities-Skia.cs" />
  </ItemGroup>

  <!-- Mobile vs Desktop EmbeddableView split. Each file is empty when its `#if`
       doesn't match, but excluding outright keeps build output clean. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) or '$(_Cocos2DUIKitTfm)' == 'true'">
    <Compile Remove="$(Cocos2DSourceRoot)EmbeddableView\CCGameView.Desktop.cs"
             Condition="Exists('$(Cocos2DSourceRoot)EmbeddableView\CCGameView.Desktop.cs')" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-android')) and '$(_Cocos2DUIKitTfm)' != 'true'">
    <Compile Remove="$(Cocos2DSourceRoot)EmbeddableView\CCGameView.Mobile.cs"
             Condition="Exists('$(Cocos2DSourceRoot)EmbeddableView\CCGameView.Mobile.cs')" />
  </ItemGroup>

  <!-- ============================================================
       Package references (versions centralized in the repo-root
       Directory.Packages.props)
       ============================================================ -->
  <ItemGroup>
    <!-- MGCB MSBuild content-pipeline task. Ships as a package dependency for
         parity with the legacy package line. NOTE (verified against 3.8.4.1):
         the MGCB package provides build/ targets only - no buildTransitive/ -
         so SDK-style consumers of this package do NOT import the MGCB targets
         transitively; game projects that use the content pipeline reference
         MonoGame.Content.Builder.Task directly (standard MonoGame practice).
         The Cocos2D-Mono.Core metapackage additionally excludes build assets
         on its dependency edge as future-proofing. -->
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <!-- ICSharpCode.SharpZipLib types are imported by CCParticleSystem.cs.
         Required on every TFM. -->
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>

  <!-- DesktopGL (base TFM) -->
  <ItemGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <!-- WindowsDX -->
  <ItemGroup Condition="'$(TargetFramework)' == '$(Cocos2DWindowsTfm)'">
    <PackageReference Include="MonoGame.Framework.WindowsDX" />
    <PackageReference Include="BitMiracle.LibTiff.NET" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <!-- Android -->
  <ItemGroup Condition="'$(TargetFramework)' == '$(Cocos2DAndroidTfm)'">
    <PackageReference Include="MonoGame.Framework.Android" />
  </ItemGroup>

  <!-- iOS -->
  <ItemGroup Condition="'$(TargetFramework)' == '$(Cocos2DIosTfm)'">
    <PackageReference Include="MonoGame.Framework.iOS" />
  </ItemGroup>

  <!-- Mac Catalyst: no MonoGame NuGet package exists for this platform, so the
       assembly built from our fork is referenced directly. The root comes from the
       repo-root Directory.Build.props; the configuration folder mirrors this build's. -->
  <ItemGroup Condition="'$(TargetFramework)' == '$(Cocos2DMacCatalystTfm)'">
    <Reference Include="MonoGame.Framework">
      <HintPath>$(MonoGameMacCatalystArtifactsRoot)$(Configuration)\MonoGame.Framework.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Source Link (all TFMs) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- ============================================================
       Project references
       ============================================================ -->
  <ItemGroup>
    <ProjectReference Include="..\Box2D\Box2D.csproj" />
  </ItemGroup>

  <!-- ============================================================
       NuGet pack content
       ============================================================ -->
  <ItemGroup>
    <None Include="..\..\Logos\logo-small.png" Pack="True" PackagePath="" Visible="false" />
    <None Include="..\..\README.md"           Pack="True" PackagePath="" Visible="false" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
