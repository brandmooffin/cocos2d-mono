<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Phase 1b step 2: full consolidation. Replaces all 13 legacy test projects
      with a single multi-targeted exe-host.

      Source still lives under Tests/cocos2d-mono.Tests/ during the side-by-side
      transition; this csproj globs it and references the legacy per-platform
      resource folders (AndroidManifest.xml, Resources/, Info.plist, etc.) in
      place via Link. The actual file moves happen in Phase 1c when the legacy
      test csprojs are deleted.

      Mobile (Android + iOS) cannot be locally validated without the .NET
      workloads; CI is the validator.
    -->
    <TargetFrameworks>$(Cocos2DTargetFrameworks)</TargetFrameworks>
    <RootNamespace>tests</RootNamespace>
    <AssemblyName>Cocos2DMono.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Desktop-only manifest + icon. Android / iOS have their own. -->
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)' or '$(TargetFramework)' == '$(Cocos2DWindowsTfm)'">
    <ApplicationManifest>..\..\Tests\cocos2d-mono.Tests\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\Tests\cocos2d-mono.Tests\Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- ============================================================
       Per-TFM platform defines (mirror Cocos2DMono.csproj exactly).
       ============================================================ -->
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)'">
    <OutputType>WinExe</OutputType>
    <DefineConstants>$(DefineConstants);OPENGL;MONOGAME;DESKTOPGL</DefineConstants>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)' and '$([MSBuild]::IsOSPlatform(`Windows`))' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWSGL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)' and '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true'">
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DBaseTfm)' and '$([MSBuild]::IsOSPlatform(`Linux`))' == 'true'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DWindowsTfm)'">
    <OutputType>WinExe</OutputType>
    <!-- Mirrors Cocos2DMono.csproj net9.0-windows7.0 DefineConstants: WINDOWS;XNA
         only (no MONOGAME — see Cocos2DMono.csproj rationale around CCContentManager
         accessibility). -->
    <DefineConstants>$(DefineConstants);WINDOWS;XNA</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>
    <MonoGamePlatform>Windows</MonoGamePlatform>
  </PropertyGroup>

  <!-- ============================================================
       Android (net9.0-android35.0)
       ============================================================ -->
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DAndroidTfm)'">
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);ANDROID;OPENGL;GLES;MONOGAME</DefineConstants>
    <MonoGamePlatform>Android</MonoGamePlatform>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <AndroidApplication>true</AndroidApplication>
    <AndroidManifest>..\cocos2d-mono.Tests\cocos2d-mono.Tests.Android\AndroidManifest.xml</AndroidManifest>
    <MonoAndroidResourcePrefix>..\cocos2d-mono.Tests\cocos2d-mono.Tests.Android\Resources</MonoAndroidResourcePrefix>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == '$(Cocos2DAndroidTfm)'">
    <!-- AndroidResource items pulled in from the legacy folder; Phase 1c moves
         them into Tests/Cocos2DMono.IntegrationTests/Android/Resources/. -->
    <AndroidResource Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.Android\Resources\**\*.xml" />
    <AndroidResource Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.Android\Resources\**\*.axml" />
    <AndroidResource Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.Android\Resources\**\*.png" />
  </ItemGroup>

  <!-- ============================================================
       iOS (net9.0-ios18.0)
       ============================================================ -->
  <PropertyGroup Condition="'$(TargetFramework)' == '$(Cocos2DIosTfm)'">
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);__IOS__;__MOBILE__;__UNIFIED__;IPHONE;IOS;GLES;OPENGL;MONOGAME</DefineConstants>
    <MonoGamePlatform>iOS</MonoGamePlatform>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <IPhoneResourcePrefix>..\cocos2d-mono.Tests\cocos2d-mono.Tests.iOS</IPhoneResourcePrefix>
    <CodesignEntitlements>..\cocos2d-mono.Tests\cocos2d-mono.Tests.iOS\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == '$(Cocos2DIosTfm)'">
    <!-- iOS app bundle inputs pulled from the legacy folder. -->
    <None Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.iOS\Info.plist" Link="Info.plist" LogicalName="Info.plist" />
    <None Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.iOS\Entitlements.plist" Link="Entitlements.plist" />
    <InterfaceDefinition Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.iOS\LaunchScreen.storyboard" Link="LaunchScreen.storyboard" />
    <ImageAsset Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.iOS\Assets.xcassets\**\*.png">
      <Visible>false</Visible>
    </ImageAsset>
    <ImageAsset Include="..\cocos2d-mono.Tests\cocos2d-mono.Tests.iOS\Assets.xcassets\**\Contents.json">
      <Visible>false</Visible>
    </ImageAsset>
  </ItemGroup>

  <!-- ============================================================
       Source globbing (replaces cocos2d-mono.Tests.projitems)
       ============================================================ -->
  <PropertyGroup>
    <TestsSourceRoot>..\..\Tests\cocos2d-mono.Tests\</TestsSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Glob the shared Tests source. Exclusions:
        bin/ obj/                        build artifacts
        cocos2d-mono.Tests.*             legacy per-platform test csproj folders
        Properties\AssemblyInfo*.cs      SDK auto-generates assembly info.
        **\*.Designer.cs                 generated; none today, glob is defensive.

      Both Box2DTestBet/ (Farseer Physics 3.3 XNA, self-contained namespaces
      FarseerPhysics.* / Poly2Tri.* / tests.classes.tests.Box2DTestBet) AND
      Box2DTestBet(Box2D)/ (modern Box2D port, namespace Box2D.TestBed) are
      INCLUDED. TestController.cs:350/352 reference both — Farseer's
      tests.classes.tests.Box2DTestBet.Box2dTestBedScene and the modern
      Box2D.TestBed.Box2dTestBedScene — for a runtime switch between the two
      test beds. No type collisions: types live in different namespaces.
    -->
    <Compile Include="$(TestsSourceRoot)**\*.cs"
             Exclude="$(TestsSourceRoot)bin\**;$(TestsSourceRoot)obj\**;$(TestsSourceRoot)cocos2d-mono.Tests.*\**;$(TestsSourceRoot)Properties\AssemblyInfo*.cs;$(TestsSourceRoot)**\*.Designer.cs" />
  </ItemGroup>

  <!-- Embedded resources (icons, .config) at the Tests root. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Tests\cocos2d-mono.Tests\Icon.bmp"
                     Link="Icon.bmp" />
    <EmbeddedResource Include="..\..\Tests\cocos2d-mono.Tests\Icon.ico"
                     Link="Icon.ico" />
  </ItemGroup>

  <!-- ============================================================
       Project references
       ============================================================ -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cocos2DMono\Cocos2DMono.csproj" />
    <ProjectReference Include="..\..\src\Box2D\Box2D.csproj" />
  </ItemGroup>

  <!-- ============================================================
       MGCB content reference

       Deferred to Phase 1b step 2: building Content.mgcb requires the
       dotnet-mgcb tool (3.8.4.1) restored via a local tool manifest at
       .config/dotnet-tools.json. The desktop build/CI validates source
       compilation only — the test harness is not executed in CI. When
       mobile bits land, the tool manifest is added alongside.
       ============================================================ -->
  <!--
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\..\Tests\cocos2d-mono.Tests\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </MonoGameContentReference>
  </ItemGroup>
  -->


</Project>
