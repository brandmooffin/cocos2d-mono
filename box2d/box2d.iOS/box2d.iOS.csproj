<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>11.0</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>box2d.iOS</RootNamespace>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <IPhoneResourcePrefix>Resources</IPhoneResourcePrefix>
    <AssemblyName>box2d.iOS</AssemblyName>
    <Title>box2d for iOS</Title>
    <Authors>Cocos2D-Mono Team, Broken Walls Studios</Authors>
    <Version>2.5.9</Version>
    <Description>box2d for iOS</Description>
    <Copyright>Copyright © 2026 Cocos2D-Mono Team; Broken Walls Studios, LLC.</Copyright>
    <PackageProjectUrl>https://github.com/Cocos2D-Mono/cocos2d-mono</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cocos2D-Mono/cocos2d-mono</RepositoryUrl>
    <PackageReleaseNotes>
- Added CCDrawNodeRetained for retained-mode drawing with shape handles (move, recolor, remove without Clear)
- Added CCPixelLabel optimized for frequent text updates with pre-cached character textures
- Added CCSoundHandle for per-instance audio control (volume, pan, pitch, stop, pause)
- Added CCFontManager for easy switching between content pipeline and direct TTF font loading
- Added CCCollision category/mask filtering with CollisionCategory and CollisionCategoryMask on CCNode
- Added CCEaseMath standalone easing utilities (Quad, Cubic, Lerp, ExpSmooth)
	</PackageReleaseNotes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\iOS\Debug</OutputPath>
    <IntermediateOutputPath>obj\iOS\Debug</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\iOS\Debug</BaseIntermediateOutputPath>
    <DefineConstants>DEBUG;__IOS__;__MOBILE__;__UNIFIED__;</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <ConsolePause>false</ConsolePause>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>full</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\iOS\Release</OutputPath>
    <IntermediateOutputPath>obj\iOS\Release</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\iOS\Release</BaseIntermediateOutputPath>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <ConsolePause>false</ConsolePause>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <Import Project="..\box2d.projitems" Label="Shared" />
</Project>