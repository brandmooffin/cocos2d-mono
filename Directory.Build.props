<Project>
  <PropertyGroup>
    <!-- Centralized MonoGame version for all projects -->
    <MonoGameVersion>3.8.4.1</MonoGameVersion>
  </PropertyGroup>

  <!--
    ==================== TFM version dials ====================

    Bumping .NET or per-platform TFMs is a single-file edit here. Consumed by
    src/Cocos2DMono/Cocos2DMono.csproj, src/Box2D/Box2D.csproj, and
    tests/Cocos2DMono.IntegrationTests/Cocos2DMono.IntegrationTests.csproj via
    $(Cocos2DTargetFrameworks) and the per-TFM Condition checks.

    Legacy csprojs under cocos2d/, box2d/, and Tests/ do NOT reference these
    properties, so adding them here is a no-op for the legacy build.

    The release/2.6.0-preview branch overrides these four properties (plus
    MonoGameVersion above) to move the whole build to net10.0 + MonoGame 3.8.5;
    no csproj edits required. This is Phase 1d in MODERNIZATION.md.
  -->
  <PropertyGroup>
    <Cocos2DBaseTfm>net9.0</Cocos2DBaseTfm>
    <Cocos2DWindowsTfm>net9.0-windows7.0</Cocos2DWindowsTfm>
    <Cocos2DAndroidTfm>net9.0-android35.0</Cocos2DAndroidTfm>
    <Cocos2DIosTfm>net9.0-ios18.0</Cocos2DIosTfm>
    <Cocos2DTargetFrameworks>$(Cocos2DBaseTfm);$(Cocos2DWindowsTfm);$(Cocos2DAndroidTfm);$(Cocos2DIosTfm)</Cocos2DTargetFrameworks>
  </PropertyGroup>
</Project>
